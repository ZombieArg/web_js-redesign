NEXT_PUBLIC_SITE_URL=https://datavoices.com.ar
NEXT_PUBLIC_API_BASE_URL=https://ceciliabot.datavoices.com.ar/api
NEXT_PUBLIC_CONTACT_EMAIL=hola@datavoices.com.ar
NEXT_PUBLIC_WHATSAPP_NUMBER=5491173709382

# Medición (PostHog). Sin la key no se inicializa nada ni se mandan eventos.
# Project API Key del proyecto en PostHog (Settings > Project > Project API Key)
NEXT_PUBLIC_POSTHOG_KEY=
# Región del proyecto: https://us.i.posthog.com o https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# noindex global: setear en "true" SOLO en entornos de preview/staging
NEXT_PUBLIC_NOINDEX_ALL=

# Envío del formulario de contacto (Netlify Function netlify/functions/send-email.mts).
# NO llevan prefijo NEXT_PUBLIC_: son secretas y solo se leen del lado servidor.
# Sin ellas la función responde 503 y el formulario muestra el toast de error.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
