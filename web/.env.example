NEXT_PUBLIC_SITE_URL=https://datavoices.com.ar
NEXT_PUBLIC_CONTACT_EMAIL=hola@datavoices.com.ar
NEXT_PUBLIC_WHATSAPP_NUMBER=5491173709382

# Medición (PostHog). Sin la key no se inicializa nada ni se mandan eventos.
# Project API Key del proyecto en PostHog (Settings > Project > Project API Key)
NEXT_PUBLIC_POSTHOG_KEY=
# Región del proyecto: https://us.i.posthog.com o https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# noindex global: setear en "true" SOLO en entornos de preview/staging
NEXT_PUBLIC_NOINDEX_ALL=

# Blog: preview muestra las cinco notas; habilitar en producción solo al publicar.
NEXT_PUBLIC_BLOG_PUBLIC=
# Fecha editorial fija de las cinco notas: 2026-10-27 (en src/content/blog/data.ts).

# El Route Handler /api/contact envía cada consulta al CRM desde el servidor.
# Configurar URL HTTPS de Hetzner en Netlify; para desarrollo local usar
# http://127.0.0.1:3002/api/inbound/web. El token debe coincidir con
# WEB_INGEST_TOKEN del CRM y nunca debe llevar prefijo NEXT_PUBLIC_.
CRM_INGEST_URL=
CRM_WEB_INGEST_TOKEN=

# Aviso por email opcional después de confirmar persistencia en CRM.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
MAIL_FROM=Formulario web <hola@datavoices.com.ar>
CONTACT_NOTIFY_EMAIL=hola@datavoices.com.ar
