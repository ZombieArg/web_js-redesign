NEXT_PUBLIC_SITE_URL=https://datavoices.com.ar
NEXT_PUBLIC_API_BASE_URL=https://ceciliabot.datavoices.com.ar/api
NEXT_PUBLIC_CONTACT_EMAIL=hola@datavoices.com.ar
NEXT_PUBLIC_WHATSAPP_NUMBER=5491173709382

# Medición (PostHog). Sin la key no se inicializa nada ni se mandan eventos.
# Project API Key del proyecto en PostHog (Settings > Project > Project API Key)
NEXT_PUBLIC_POSTHOG_KEY=
# Región del proyecto: https://us.i.posthog.com o https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# noindex global: setear en "true" SOLO en entornos de preview/staging
NEXT_PUBLIC_NOINDEX_ALL=

# Blog: preview muestra borradores; producción muestra solo notas con fecha real de publicación.
NEXT_PUBLIC_BLOG_PUBLIC=
# Fecha y hora del primer deploy de la nota 1 en producción (hora de Buenos Aires).
# Ejemplo de formato: 2026-10-23T16:30:00-03:00. Dejar vacío hasta ese deploy.
NEXT_PUBLIC_BLOG_NOTA_01_PUBLISHED_AT=
# Completar solo al editar la nota después de publicarla; si está vacío usa la fecha anterior.
NEXT_PUBLIC_BLOG_NOTA_01_MODIFIED_AT=
# Las notas 2 a 5 conservan el estado de borrador hasta tener su fecha real.
NEXT_PUBLIC_BLOG_NOTA_02_PUBLISHED_AT=
NEXT_PUBLIC_BLOG_NOTA_02_MODIFIED_AT=
NEXT_PUBLIC_BLOG_NOTA_03_PUBLISHED_AT=
NEXT_PUBLIC_BLOG_NOTA_03_MODIFIED_AT=
NEXT_PUBLIC_BLOG_NOTA_04_PUBLISHED_AT=
NEXT_PUBLIC_BLOG_NOTA_04_MODIFIED_AT=
NEXT_PUBLIC_BLOG_NOTA_05_PUBLISHED_AT=
NEXT_PUBLIC_BLOG_NOTA_05_MODIFIED_AT=

# Envío del formulario de contacto (Netlify Function netlify/functions/send-email.mts).
# NO llevan prefijo NEXT_PUBLIC_: son secretas y solo se leen del lado servidor.
# Sin ellas la función responde 503 y el formulario muestra el toast de error.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
