# Backend de envío de mail (Mailgun) para ceciliabot.datavoices.com.ar
# Hosteado en un VPS de Hetzner, separado del sitio Netlify (client/ y web/).
# Copiar a .env (gitignoreado) y completar con los valores reales del panel de Mailgun.

# Mailgun → Sending → Domain settings → API keys
MAILGUN_API_KEY=
# Dominio verificado en Mailgun usado para enviar (ej: mg.datavoices.com.ar)
MAILGUN_DOMAIN=

# Puerto del servidor Express (opcional, default 5001)
port=5001
